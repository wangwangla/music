<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_music_control_bg"
    android:minHeight="148dp"
    android:padding="16dp">

    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/song_name"
        android:scaleType="centerCrop"
        android:src="@mipmap/default_image2" />

    <TextView
        android:id="@+id/widget_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:background="@drawable/widget_status_chip_bg"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="@string/widget_status_paused"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_text_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/widget_album_art"
        android:layout_marginStart="14dp"
        android:layout_toEndOf="@id/widget_album_art"
        android:layout_toStartOf="@id/widget_status_text"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_song_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_song_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_not_playing"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_hint_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_tap_to_open"
            android:textColor="#99FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_below="@id/widget_album_art"
        android:layout_marginTop="14dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/process_process_bar" />

    <LinearLayout
        android:id="@+id/widget_action_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_progress"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_action_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_control_button_bg"
            android:contentDescription="@string/widget_action_previous"
            android:padding="10dp"
            android:src="@mipmap/ic_skip_previous_white_36dp" />

        <ImageView
            android:id="@+id/widget_action_play_pause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/widget_control_button_bg"
            android:contentDescription="@string/widget_action_play_pause"
            android:padding="10dp"
            android:src="@mipmap/ic_play_white_36dp" />

        <ImageView
            android:id="@+id/widget_action_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_control_button_bg"
            android:contentDescription="@string/widget_action_next"
            android:padding="10dp"
            android:src="@mipmap/ic_skip_next_white_36dp" />
    </LinearLayout>

</RelativeLayout>

